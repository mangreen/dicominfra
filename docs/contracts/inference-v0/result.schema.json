{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicominfra.invalid/contracts/inference-v0/result.schema.json",
  "title": "推論結果 v0.1（草案，待 DS 團隊審閱）",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "status", "model", "completed_at"],
  "properties": {
    "contract_version": { "const": "0.1" },
    "request_id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["succeeded", "failed"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "measurements": {
      "description": "數值一律以十進位字串表示，避免浮點誤差；單位使用 UCUM。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
          "unit": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "description": "true 表示我方可以稍後重試。", "type": "boolean" }
      }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "if": { "properties": { "status": { "const": "succeeded" } } },
  "then": { "required": ["measurements"], "not": { "required": ["error"] } },
  "else": { "required": ["error"], "not": { "required": ["measurements"] } }
}
